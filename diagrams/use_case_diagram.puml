@startuml usecase_diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick

actor Student
actor Firma
actor "Administrátor" as Admin
actor Systém

package "Student" {
  usecase "Vytvořit a upravit profil" as UC1
  usecase "Nahrát CV" as UC2
  usecase "Vyhledávat nabídky" as UC3
  usecase "Filtrovat nabídky" as UC4
  usecase "Reagovat na inzerát" as UC5
  usecase "Přehled reakcí" as UC6
  usecase "Chat s firmou" as UC7
}

package "Firma" {
  usecase "Spravovat profil firmy" as UC8
  usecase "Spravovat inzeráty" as UC9
  usecase "Spravovat uchazeče" as UC10
  usecase "Změnit stav uchazeče" as UC11
  usecase "Stahovat životopisy" as UC12
  usecase "Chat se studenty" as UC13
}

package "Administrátor" {
  usecase "Schvalovat nové firmy" as UC14
  usecase "Spravovat uživatelské účty" as UC15
  usecase "Moderovat obsah" as UC16
  usecase "Zobrazit statistiky platformy" as UC17
}

package "Systém" {
  usecase "Registrovat se jako Student/Firma" as UC18
  usecase "Blokovat neověřené firmy" as UC19
  usecase "Vymazat účet (GDPR)" as UC20
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC7
Firma --> UC8
Firma --> UC9
Firma --> UC10
Firma --> UC11
Firma --> UC12
Firma --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Systém --> UC18
Systém --> UC19
Systém --> UC20

@enduml